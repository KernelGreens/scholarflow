// Phase 1 baseline schema — ScholarFlow AI
// Extends in later phases: literature, evidence, positioning, design,
// methodology, experiments, writing, automation, commercial, governance.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TenantType {
  PERSONAL
  GROUP
  INSTITUTION
}

enum TenantRole {
  OWNER
  WORKSPACE_ADMIN
  RESEARCHER
  SUPERVISOR
  REVIEWER
  VIEWER
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum PrivacyLevel {
  PRIVATE
  SHARED
  PUBLIC
}

enum AutomationRunStatus {
  QUEUED
  DISPATCHING
  RUNNING
  PARTIAL
  COMPLETED
  FAILED
  CANCEL_REQUESTED
  CANCELLED
  TIMED_OUT
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  tenantMemberships TenantMembership[]
  projectMemberships ProjectMembership[]
  createdBy         ResearchProject[]
  passwordResetTokens PasswordResetToken[]
}

model Account {
  id                String  @id @default(cuid())
  userId           String
  type             String
  provider         String
  providerAccountId String
  accessToken      String?
  refreshToken     String?
  expiresAt        DateTime?
  idToken          String?
  sessionState     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId      String
  expiresAt   DateTime
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  expires    DateTime
  token      String  @unique

  @@unique([identifier, token])
}

model Tenant {
  id        String       @id @default(cuid())
  slug     String       @unique
  name     String
  type     TenantType   @default(PERSONAL)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  memberships   TenantMembership[]
  invitations   Invitation[]
  projects      ResearchProject[]
  automationRuns AutomationRun[]
}

model TenantMembership {
  id        String   @id @default(cuid())
  tenantId String
  userId   String
  role     TenantRole @default(RESEARCHER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
}

model Invitation {
  id            String   @id @default(cuid())
  tenantId      String
  email        String
  role         TenantRole @default(VIEWER)
  invitedByUserId String?
  status       String   @default("PENDING")
  expiresAt    DateTime?
  acceptedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model ProjectMembership {
  id        String   @id @default(cuid())
  projectId String
  userId   String
  role     String   @default("OWNER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

// ---------------------------------------------------------------------------
// Research management (Phase 1 baseline)
// ---------------------------------------------------------------------------

model ResearchProject {
  id                    String         @id @default(cuid())
  tenantId              String
  createdById          String
  title                String
  shortTitle           String?
  description          String?
  discipline           String?
  status               ProjectStatus @default(DRAFT)
  phase                String         @default("RESEARCH_DISCOVERY")
  aim                  String?
  institution          String?
  programmeType        String?
  startDate            DateTime?
  targetCompletionDate DateTime?
  keywords             String[]
  tags                 String[]
  privacy              PrivacyLevel  @default(PRIVATE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy   User               @relation(fields: [createdById], references: [id], onDelete: Cascade)
  memberships ProjectMembership[]
  phases ResearchPhase[]

  automationRuns AutomationRun[]
}

model ResearchPhase {
  id         String   @id @default(cuid())
  projectId String
  phase     String
  sequence  Int      @default(0)
  status    String   @default("PENDING")
  startedAt DateTime?
  completedAt DateTime?
  notes     String?

  project ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sequence])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Automation (Phase 2 — Research Discovery backend)
// ---------------------------------------------------------------------------

model AutomationRun {
  id               String               @id @default(cuid())
  tenantId         String
  projectId        String
  workflowKey      String               @default("RESEARCH_DISCOVERY")
  workflowVersion  Int                  @default(1)
  status           AutomationRunStatus @default(QUEUED)
  correlationId    String               @unique
  idempotencyKey  String               @unique
  requestedBy      String
  createdAt        DateTime @default(now())
  startedAt        DateTime?
  completedAt      DateTime?
  usage            Json?
  results          Json?

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project     ResearchProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  events      AutomationRunEvent[]

  @@index([tenantId, status])
}

model AutomationRunEvent {
  id        String   @id @default(cuid())
  runId     String
  type      String
  status    String?
  payload   Json?
  timestamp DateTime @default(now())

  run AutomationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, timestamp])
}
